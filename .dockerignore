# Keep secrets, VCS data and local artifacts out of the build context (and therefore the image).
.env
.env.*
!.env.example
.git
.gitignore
.venv
.python-version

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Not needed at runtime
tests/
docs/
infra/
Dockerfile
docker-compose*.yml
Makefile
CLAUDE.md
.claude/

# Local runtime data and Terraform state must never enter an image
/data/
/storage/
.terraform/
*.tfstate
*.tfstate.*
