# DocuSearch — local development configuration template.
# Copy to `.env` (which is git-ignored) and adjust. No real credentials are needed locally.
#
# STATUS: variables are introduced by the milestone noted in brackets. Currently the
# application reads APP_ENV, LOG_LEVEL, the MONGODB_* and the JWT_* / ACCESS_TOKEN_* variables
# (src/docusearch/core/settings.py); all other variables are a planning template and are
# ignored until their milestone. Keep this file in sync with the Settings class whenever
# fields are added.
# Comments are on their own lines on purpose: inline comments are parsed differently by
# python-dotenv, Docker Compose and shells.

# --- Application [M1] ---
# APP_ENV: local | test | production
APP_ENV=local
LOG_LEVEL=INFO

# --- MongoDB [M2] ---
# For the API running on the host (make run). Docker Compose overrides this with
# mongodb://mongo:27017 for the api container. The URI may contain credentials: never commit it.
MONGODB_URI=mongodb://localhost:27017
# Letters, digits, "_" and "-" only.
MONGODB_DB_NAME=docusearch
# Server selection / connect timeout, 100-60000.
MONGODB_TIMEOUT_MS=2000

# --- Redis / RQ [M5] ---
REDIS_URL=redis://redis:6379/0

# --- Auth [M3] ---
# Signing key for access tokens, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave it unset for local development: a random key is generated per process (tokens then stop
# working on restart). It is REQUIRED when APP_ENV=production. Never commit a real value.
# JWT_SECRET_KEY=
# Only HS256 is supported.
JWT_ALGORITHM=HS256
# 1-60
ACCESS_TOKEN_TTL_MINUTES=15
# Lifetime of a session (refresh tokens rotate but never extend it), 1-90 days.
REFRESH_TOKEN_TTL_DAYS=14

# --- Storage / uploads [M4] ---
# STORAGE_BACKEND: local | s3 (s3 is only prepared in M11)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/uploads
MAX_UPLOAD_SIZE_MB=25

# --- Chunking [M5] ---
# Character-based estimates at first; not exact token counts.
CHUNK_TARGET_SIZE=800
CHUNK_OVERLAP=100

# --- Optional LLM [M9] ---
# Disabled by default; core features never need a key.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
