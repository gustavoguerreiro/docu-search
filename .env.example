# DocuSearch — local development configuration template.
# Copy to `.env` (which is git-ignored) and adjust. No real credentials are needed locally.
#
# STATUS: variables are introduced by the milestone noted in brackets. Currently the
# application reads only APP_ENV and LOG_LEVEL (src/docusearch/core/settings.py); all other
# variables are a planning template and are ignored until their milestone. Keep this file in
# sync with the Settings class whenever fields are added.
# Comments are on their own lines on purpose: inline comments are parsed differently by
# python-dotenv, Docker Compose and shells.

# --- Application [M1] ---
# APP_ENV: local | test | production
APP_ENV=local
LOG_LEVEL=INFO

# --- MongoDB [M2] ---
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=docusearch

# --- Redis / RQ [M5] ---
REDIS_URL=redis://redis:6379/0

# --- Auth [M3] ---
# Local-only placeholder. The app must refuse to start in production with this value.
JWT_SECRET_KEY=change-me-local-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# --- Storage / uploads [M4] ---
# STORAGE_BACKEND: local | s3 (s3 is only prepared in M11)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/uploads
MAX_UPLOAD_SIZE_MB=25

# --- Chunking [M5] ---
# Character-based estimates at first; not exact token counts.
CHUNK_TARGET_SIZE=800
CHUNK_OVERLAP=100

# --- Optional LLM [M9] ---
# Disabled by default; core features never need a key.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
